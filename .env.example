# ========================================================
# HealthTech Patient Data Dashboard - Environment Config
# ========================================================

APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database (Supabase PostgreSQL / AWS RDS / Local PostgreSQL)
# Supabase Pooler URI example:
# postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Optional Supabase API keys
SUPABASE_URL=
SUPABASE_KEY=

# JWT Security
JWT_SECRET_KEY=change-this-insecure-secret-to-a-32-byte-random-key-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# AWS Integration (Optional for local dev, used in ECS/RDS)
AWS_REGION=us-east-1
AWS_SECRET_NAME=
